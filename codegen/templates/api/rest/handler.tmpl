func {{= t.GoName }}Handler(w http.ResponseWriter, r *http.Request) {
	switch r.Method {
    case http.MethodGet:
        get{{= t.GoPlural}}(w, r)
	case http.MethodPost:
		post{{= t.GoPlural}}(w, r)
    case http.MethodPut:
        put{{= t.GoPlural}}(w, r)
    //case http.MethodPatch:
        //patch{{= t.GoPlural}}(w, r)
	case http.MethodDelete:
		delete{{= t.GoPlural}}(w, r)
	default:
		http2.SendMethodNotAllowed(
		    http.MethodGet,
		    http.MethodPost,
		    http.MethodPut,
		    //http.MethodPatch,
		    http.MethodDelete,
		)
	}
	return
}

