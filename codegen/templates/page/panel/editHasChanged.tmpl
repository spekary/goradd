// editHasChanged.tmpl

{{

// HasChanged returns true if the user has changed one of the values in the edit form.
//
// Note that GoRADD only records changes in response to an Ajax or Server action, so only
// call this when responding to such an action.
func (p *{{= panelName }}) HasChanged() bool {
{{for _,dbRef := range dbRefs}}
{{g
    cd := t.ControlDescription(dbRef)
    if cd == nil || cd.Generator == nil {continue}
    changedString := cd.Generator.GenerateChanged(dbRef, cd)
    if changedString == "" {continue}
    var valString string

    switch ref := dbRef.(type) {
    case *db.Column:
        if ref.IsEnum() {
            valString = `p.` + t.GoName + "." + ref.ReferenceFunction() + "().ID()"
        } else {
            valString = `p.` + t.GoName + "." + ref.GoName + "()"
        }
    case *db.ReverseReference:
        if ref.IsUnique() {
            valString = `p.` + t.GoName + "." + ref.GoName + "()"
        } else {
            valString = `p.` + t.GoName + "." + ref.GoPlural + "()"
        }
    case *db.ManyManyReference:
        valString = `p.` + t.GoName + "." + ref.GoPlural + "()"
    }
}}
    if ctrl := p.{{= cd.ControlName }}(); p != nil {
        val := {{= valString }}
        if {{= changedString }} {return true}
    }
{{for}}

    return false
}

}}